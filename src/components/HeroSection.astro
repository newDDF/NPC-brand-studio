---
import { siteConfig } from '../config/site';
---

<section class="hero">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">{siteConfig.theme.preset.toUpperCase()} / ENGINEERING / INDUSTRY</p>
          <h1>{siteConfig.tagline}</h1>
          <p class="hero-description">
            We turn complex engineering challenges into dependable,
            high-performance manufacturing solutions.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#products">
              Explore our capabilities <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#about">Discover Northstar</a>
          </div>
        </div>

        <div class="hero-visual" aria-label="Abstract industrial geometry">
          <div class="visual-grid"></div>
          <div class="visual-ring visual-ring-outer"></div>
          <div class="visual-ring visual-ring-inner"></div>
          <div class="visual-core"></div>
          <span class="visual-label">NP / 001</span>
          <span class="visual-coordinate">PRECISION IN EVERY DETAIL</span>
        </div>

        <div class="hero-meta">
          <span>BUILT ON PRECISION</span>
          <span>DESIGNED FOR WHAT'S NEXT</span>
          <span>01 — 04</span>
        </div>
      </div>
    </section>
