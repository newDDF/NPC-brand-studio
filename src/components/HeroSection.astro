---
import { siteConfig } from '../config/site';
import { getHeroTranslations } from '../i18n/hero';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const content = getHeroTranslations(locale);

const brandImages = import.meta.glob(
  '/public/images/brand/*.{png,jpg,jpeg,webp}',
  {
    eager: true,
    query: '?url',
    import: 'default',
  },
) as Record<string, string>;

const heroSlides = Object.entries(brandImages)
  .map(([path, image]) => ({ path, image }))
  .sort((a, b) => {
    const aIsPoster = a.path.toLowerCase().includes('wheel-collection-poster.');
    const bIsPoster = b.path.toLowerCase().includes('wheel-collection-poster.');
    if (aIsPoster && !bIsPoster) return -1;
    if (!aIsPoster && bIsPoster) return 1;
    return a.path.localeCompare(b.path, undefined, {
      numeric: true,
      sensitivity: 'base',
    });
  })
  .map(({ path, image }, index) => ({
    image: image.replace('/public/', '/'),
    alt: path.toLowerCase().includes('wheel-collection-poster.')
      ? 'NPC Precision automotive wheel collection'
      : `NPC Precision automotive brand image ${index + 1}`,
  }));
---

<section class="hero hero-fullbleed">
  <div
    class="hero-visual hero-carousel hero-background"
    aria-label="NPC Precision featured images"
    aria-roledescription="carousel"
  >
    <div class="hero-carousel-track">
      {heroSlides.map((slide, index) => (
        <div
          class:list={['hero-carousel-slide', { 'is-active': index === 0 }]}
          aria-roledescription="slide"
          aria-label={`${index + 1} of ${heroSlides.length}`}
          aria-hidden={index !== 0 ? 'true' : 'false'}
        >
          <img
            src={slide.image}
            alt={slide.alt}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))}
    </div>

    <button class="hero-carousel-arrow hero-carousel-prev" type="button" aria-label="Previous slide">
      <span aria-hidden="true">←</span>
    </button>
    <button class="hero-carousel-arrow hero-carousel-next" type="button" aria-label="Next slide">
      <span aria-hidden="true">→</span>
    </button>

    <div class="hero-carousel-footer">
      <div class="hero-carousel-dots" aria-label="Choose a slide">
        {heroSlides.map((_, index) => (
          <button
            class:list={['hero-carousel-dot', { 'is-active': index === 0 }]}
            type="button"
            aria-label={`Go to slide ${index + 1}`}
            aria-current={index === 0 ? 'true' : undefined}
          />
        ))}
      </div>
      <span class="hero-carousel-count">
        <span class="hero-carousel-current">01</span> / {String(heroSlides.length).padStart(2, '0')}
      </span>
    </div>
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
      <p class="hero-description">{content.description}</p>

      <div class="hero-actions">
        <a class="button button-primary" href="#products">
          {content.primaryButton} <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="#about">
          {content.secondaryButton}
        </a>
      </div>
    </div>

    <div class="hero-meta">
      <span>{content.metaLeft}</span>
      <span>{content.metaCenter}</span>
      <span>{content.metaRight}</span>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.hero-carousel').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.hero-carousel-slide'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.hero-carousel-dot'));
    const currentLabel = carousel.querySelector<HTMLElement>('.hero-carousel-current');
    const previous = carousel.querySelector<HTMLButtonElement>('.hero-carousel-prev');
    const next = carousel.querySelector<HTMLButtonElement>('.hero-carousel-next');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const showSlide = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === current);
        slide.setAttribute('aria-hidden', i === current ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === current);
        if (i === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (currentLabel) currentLabel.textContent = String(current + 1).padStart(2, '0');
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (!reducedMotion && !document.hidden && slides.length > 1) {
        timer = setInterval(() => showSlide(current + 1), 5000);
      }
    };

    previous?.addEventListener('click', () => {
      showSlide(current - 1);
      start();
    });
    next?.addEventListener('click', () => {
      showSlide(current + 1);
      start();
    });
    dots.forEach((dot, index) => dot.addEventListener('click', () => {
      showSlide(index);
      start();
    }));

    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', (event) => {
      if (!carousel.contains(event.relatedTarget as Node | null)) start();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    start();
  });
</script>
