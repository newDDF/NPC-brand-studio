const t = ui[locale as keyof typeof ui] ?? ui.en;

const craftCopy = {
  en: {
    eyebrow: 'DESIGN / MATERIAL / FINISH',
    title: 'Details make the difference.',
    intro: 'Explore the surfaces, machining details and finishes behind each wheel concept.',
    alt1: 'Close-up of wheel design and surface details',
    alt2: 'Wheel finish and manufacturing details',
    caption1: 'Form, proportion and surface',
    caption2: 'Finish and precision details',
  },
  'zh-cn': {
    eyebrow: '设计 / 材料 / 表面处理',
    title: '细节，定义品质。',
    intro: '从轮辐造型到表面处理，了解塑造每一款轮毂设计的细节。',
    alt1: '轮毂设计与表面细节特写',
    alt2: '轮毂表面处理与制造细节',
    caption1: '造型、比例与表面',
    caption2: '表面处理与精细工艺',
  },
  es: {
    eyebrow: 'DISEÑO / MATERIAL / ACABADO',
