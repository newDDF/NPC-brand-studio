    alt2: 'Acabado y detalle de fabricación de una llanta',
    caption1: 'Forma, proporción y superficie',
    caption2: 'Acabado y precisión',
  },
  de: {
    eyebrow: 'DESIGN / MATERIAL / OBERFLÄCHE',
    title: 'Details machen den Unterschied.',
    intro: 'Entdecken Sie Oberflächen, Bearbeitungsdetails und Finishes unserer Felgenkonzepte.',
    alt1: 'Detailansicht von Felgendesign und Oberfläche',
    alt2: 'Felgenfinish und Fertigungsdetail',
    caption1: 'Form, Proportion und Oberfläche',
    caption2: 'Finish und Präzisionsdetails',
  },
  fr: {
    eyebrow: 'DESIGN / MATIÈRE / FINITION',
    title: 'La différence se joue dans les détails.',
    intro: 'Découvrez les surfaces, l’usinage et les finitions de chaque concept de jante.',
    alt1: 'Vue rapprochée du design et de la surface d’une jante',
    alt2: 'Finition et détail de fabrication d’une jante',
    caption1: 'Forme, proportions et surface',
    caption2: 'Finition et précision',
  },
  ja: {
    eyebrow: 'デザイン / 素材 / 仕上げ',
    title: '違いは、細部に宿る。',
