const t = ui[locale as keyof typeof ui] ?? ui.en;
const productText = copy.products;
const title = locale === 'zh-cn' ? '产品目录' : locale === 'ja' ? '製品カタログ' : locale === 'de' ? 'Produktkatalog' : locale === 'fr' ? 'Catalogue produits' : locale === 'es' ? 'Catálogo de productos' : 'Product Catalog';
---

<BaseLayout lang={locale} title={title} description={t.intro}>
  <SiteHeader />
  <main class="catalog-page" id="top">
    <section class="catalog-hero">
      <div class="container">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.title}</h1>
        <p class="catalog-intro">{t.intro}</p>
      </div>
    </section>

    <section class="container catalog-content" aria-label={title}>
      <div class="catalog-tools">
        <label class="search-field">
          <span class="sr-only">{t.search}</span>
          <span aria-hidden="true">⌕</span>
          <input type="search" data-search placeholder={t.search} />
        </label>

        <div class="filter-grid">
          <label>
            <span>{t.series}</span>
            <select data-filter="series">
              <option value="">{t.allSeries}</option>
              <option value="forged">{t.forged}</option>
              <option value="flow-formed">{t.flow}</option>
              <option value="sport">{t.sport}</option>
            </select>
          </label>
          <label>
            <span>{t.diameter}</span>
            <select data-filter="diameters">
              <option value="">{t.allDiameters}</option>
              <option value="17">17"</option>
              <option value="18">18"</option>
              <option value="19">19"</option>
              <option value="20">20"</option>
            </select>
          </label>
          <label>
            <span>{t.width}</span>
            <select data-filter="widths">
              <option value="">{t.allWidths}</option>
              <option value="7.5">7.5J</option>
              <option value="8">8J</option>
              <option value="8.5">8.5J</option>
              <option value="9">9J</option>
              <option value="9.5">9.5J</option>
            </select>
          </label>
          <label>
            <span>{t.pcd}</span>
            <select data-filter="pcd">
              <option value="">{t.allPcd}</option>
              <option value="5x100">5×100</option>
              <option value="5x112">5×112</option>
              <option value="5x114.3">5×114.3</option>
            </select>
          </label>
          <label>
            <span>{t.color}</span>
            <select data-filter="colors">
              <option value="">{t.allColors}</option>
              <option value="black">{t.black}</option>
              <option value="grey">{t.grey}</option>
              <option value="silver">{t.silver}</option>
            </select>
          </label>
          <button class="reset-button" type="button" data-reset>{t.reset}</button>
        </div>
      </div>

      <div class="catalog-results">
        <p class="result-count"><strong data-count>{catalogProducts.length}</strong> {t.results}</p>
        <div class="product-grid" data-grid>
          {catalogProducts.map((product) => {
            const translated = productText.find((item) => item.id === product.id);
            const name = translated?.title ?? product.name;
            const description = translated?.description ?? product.description;
            return (
              <article
                class="catalog-card"
                data-product
                data-series={product.series}
                data-diameters={product.diameters.join(',')}
                data-widths={product.widths.join(',')}
                data-pcd={product.pcd.join(',')}
                data-colors={product.colors.join(',')}
                data-search={`${product.name} ${product.sku} ${product.series} ${product.finish} ${product.pcd.join(' ')} ${product.diameters.join(' ')} ${product.widths.join(' ')} ${product.vehicles.join(' ')}`.toLowerCase()}
              >
                <div class="card-image">
                  <img src={`${import.meta.env.BASE_URL}${product.image.replace(/^\//, '')}`} alt={translated?.imageAlt ?? product.name} loading="lazy" />
                  <span class="concept-tag">{t.demo}</span>
                </div>
                <div class="card-body">
                  <div class="card-kicker">
                    <span>{product.sku}</span>
                    <span>{product.finish}</span>
                  </div>
                  <h2>{name}</h2>
                  <p class="card-description">{description}</p>
                  <dl class="spec-list">
                    <div>
                      <dt>{t.size}</dt>
                      <dd>{product.diameters.map((item) => `${item}"`).join(' / ')}</dd>
                    </div>
                    <div>
                      <dt>{t.widths}</dt>
                      <dd>{product.widths.map((item) => `${item}J`).join(' / ')}</dd>
                    </div>
                    <div>
                      <dt>{t.pcd}</dt>
                      <dd>{product.pcd.join(' · ')}</dd>
                    </div>
                    <div>
                      <dt>{t.fitment}</dt>
                      <dd>{product.vehicles.join(' · ')}</dd>
                    </div>
                  </dl>
                  <a class="inquiry-link" href={`mailto:${siteConfig.contact.email}?subject=${encodeURIComponent(`NPC Precision — ${product.sku}`)}`}>
                    {t.inquire} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
        <p class="empty-state" data-empty hidden>{t.empty}</p>
      </div>

      <aside class="catalog-disclaimer">
        <strong>{t.demo}</strong>
        <p>{t.disclaimer}</p>
      </aside>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .catalog-page { min-height: 65vh; }
  .catalog-hero { padding: clamp(56px, 9vw, 112px) 0 44px; border-bottom: 1px solid var(--color-border); }
  .catalog-hero h1 { max-width: 850px; margin: 0 0 22px; font-size: clamp(2.5rem, 6vw, 5.2rem); }
  .catalog-intro { max-width: 650px; margin: 0; font-size: 1.05rem; }
  .catalog-content { padding-block: 36px 84px; }
  .catalog-tools { margin-bottom: 32px; padding: 24px; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-background); }
  .search-field { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 0 15px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); color: var(--color-text-muted); }
  .search-field > span:not(.sr-only) { font-size: 1.5rem; }
  .search-field input { width: 100%; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--color-text); }
  .filter-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)) auto; gap: 14px; margin-top: 20px; align-items: end; }
  .filter-grid label { display: grid; gap: 7px; min-width: 0; }
  .filter-grid label span { color: var(--color-text-muted); font-size: 0.76rem; font-weight: 600; }
  .filter-grid select { width: 100%; min-width: 0; min-height: 42px; padding: 0 9px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-background); color: var(--color-text); }
  .reset-button { min-height: 42px; padding: 0 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); cursor: pointer; white-space: nowrap; font-size: 0.82rem; }
  .reset-button:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .result-count { margin: 0 0 18px; color: var(--color-text-muted); font-size: 0.88rem; }
  .result-count strong { color: var(--color-text); }
  .product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .catalog-card { min-width: 0; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-background); }
  .card-image { position: relative; display: grid; aspect-ratio: 4 / 3; place-items: center; overflow: hidden; background: var(--color-surface); }
  .card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 240ms ease; }
  .catalog-card:hover .card-image img { transform: scale(1.025); }
  .concept-tag { position: absolute; top: 12px; left: 12px; padding: 5px 8px; border: 1px solid rgb(255 255 255 / 55%); border-radius: 3px; background: rgb(255 255 255 / 90%); color: #333943; font-size: 0.68rem; font-weight: 650; }
  .card-body { padding: 22px; }
  .card-kicker { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; color: var(--color-text-muted); font-size: 0.7rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .card-body h2 { margin: 12px 0 10px; font-size: 1.55rem; }
  .card-description { min-height: 4.6em; margin-bottom: 20px; font-size: 0.9rem; }
  .spec-list { display: grid; gap: 0; margin: 0; border-top: 1px solid var(--color-border); }
  .spec-list > div { display: grid; grid-template-columns: minmax(95px, 0.8fr) 1.2fr; gap: 10px; padding: 11px 0; border-bottom: 1px solid var(--color-border); font-size: 0.76rem; }
  .spec-list dt { color: var(--color-text-muted); }
  .spec-list dd { margin: 0; overflow-wrap: anywhere; text-align: right; }
  .inquiry-link { display: flex; justify-content: space-between; gap: 12px; margin-top: 20px; color: var(--color-accent); font-size: 0.88rem; font-weight: 650; }
  .catalog-disclaimer { margin-top: 36px; padding: 20px 22px; border-left: 3px solid var(--color-accent); background: var(--color-surface); font-size: 0.85rem; }
  .catalog-disclaimer p { margin: 6px 0 0; font-size: 0.8rem; }
  .empty-state { padding: 42px 12px; text-align: center; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 1100px) { .filter-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .catalog-hero { padding-block: 52px 34px; } .catalog-content { padding-top: 22px; } .catalog-tools { padding: 14px; } .filter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } .reset-button { width: 100%; } .product-grid { grid-template-columns: 1fr; } .card-body { padding: 18px; } .card-description { min-height: 0; } }
</style>

<script>
  const catalogRoot = document.querySelector('.catalog-page');

  if (catalogRoot) {
    const search = catalogRoot.querySelector('[data-search]');
    const filters = Array.from(catalogRoot.querySelectorAll('[data-filter]'));
    const cards = Array.from(catalogRoot.querySelectorAll('[data-product]'));
    const count = catalogRoot.querySelector('[data-count]');
    const empty = catalogRoot.querySelector('[data-empty]');
    const reset = catalogRoot.querySelector('[data-reset]');

    const updateCatalog = () => {
      const query = (search instanceof HTMLInputElement ? search.value : '').trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const searchable = card.getAttribute('data-search') ?? '';
        const matchesQuery = searchable.includes(query);
        const matchesFilters = filters.every((filter) => {
          if (!(filter instanceof HTMLSelectElement) || !filter.value) return true;
          const values = (card.getAttribute(`data-${filter.dataset.filter}`) ?? '').split(',');
          return values.includes(filter.value);
        });
        const show = matchesQuery && matchesFilters;
        card.toggleAttribute('hidden', !show);
        if (show) visible += 1;
      });

      if (count) count.textContent = String(visible);
      if (empty) empty.toggleAttribute('hidden', visible > 0);
    };

    search?.addEventListener('input', updateCatalog);
    filters.forEach((filter) => filter.addEventListener('change', updateCatalog));
    reset?.addEventListener('click', () => {
      if (search instanceof HTMLInputElement) search.value = '';
      filters.forEach((filter) => {
        if (filter instanceof HTMLSelectElement) filter.value = '';
      });
      updateCatalog();
    });
    updateCatalog();
  }
</script>
