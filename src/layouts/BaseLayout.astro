---
import '../styles/global.css';
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  lang = siteConfig.defaultLocale,
} = Astro.props;

const pageTitle =
  title === siteConfig.name ? title : `${title} — ${siteConfig.name}`;

const configuredUrl =
  siteConfig.url && !siteConfig.url.includes('example.com')
    ? siteConfig.url.replace(/\/+$/, '')
    : '';

const localeCodes: Record<string, string> = {
  en: 'en_US',
  'zh-cn': 'zh_CN',
  es: 'es_ES',
  de: 'de_DE',
  fr: 'fr_FR',
  ja: 'ja_JP',
};

const localePath = (locale: string) =>
  locale === siteConfig.defaultLocale ? '/' : `/${locale}/`;

const currentPath =
  Astro.url.pathname.endsWith('/')
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`;

const canonicalUrl = configuredUrl
  ? new URL(currentPath, `${configuredUrl}/`).href
  : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={siteConfig.theme.accent} />

    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    {configuredUrl &&
      siteConfig.locales.map((locale) => (
        <link
          rel="alternate"
          hreflang={locale}
          href={new URL(localePath(locale), `${configuredUrl}/`).href}
        />
      ))}
    {configuredUrl && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL('/', `${configuredUrl}/`).href}
      />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={localeCodes[lang] ?? 'en_US'} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
